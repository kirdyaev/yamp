{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Yamp",
  "version": "0.1.0",
  "identifier": "dev.kirdyaev.yamamp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Yamp",
        "width": 275,
        "height": 544,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: yamamp: data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline' data: blob:; img-src 'self' data: blob: asset: tauri:; font-src 'self' data: blob:; media-src 'self' yamamp: blob: data: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost yamamp: blob: data: http://127.0.0.1:*; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "infoPlist": "Info.plist"
    }
  }
}
